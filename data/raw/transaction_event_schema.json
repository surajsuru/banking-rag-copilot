{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransactionEvent",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "transactionId",
    "occurredAt",
    "status",
    "amount",
    "currency",
    "correlationId"
  ],
  "properties": {
    "eventId": {
      "type": "string"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "TransactionCreated",
        "TransactionPosted",
        "TransactionReversed",
        "TransactionFailed"
      ]
    },
    "transactionId": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "correlationId": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
